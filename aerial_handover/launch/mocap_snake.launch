<launch>
    <node pkg="mocap_optitrack" type="mocap_node" name="mocap_snake" respawn="false">
        <rosparam subst_value="true">
            rigid_bodies:
                '4':
                    pose: /snake_head/mocap/pose
                    pose2d: /snake_head/mocap/pose2d
                    child_frame_id: baselink
                    parent_frame_id: world
            optitrack_config:
                multicast_address: 239.255.42.99
                command_port: 1510
                data_port: 1511
        </rosparam>
    </node>
</launch>
