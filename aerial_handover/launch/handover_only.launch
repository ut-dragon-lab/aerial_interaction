<launch>
  <node pkg="mocap_optitrack" type="mocap_node" name="mocap" respawn="false" output="screen">
    <rosparam subst_value="true">
      rigid_bodies:
        '2':
          pose: /hand/mocap/pose
          pose2d: /hand/mocap/pose2d
          parent_frame_id: world
          child_frame_id: hand_baselink
        '4':
          pose: /snake_head/mocap/pose
          pose2d: /snake_head/mocap/pose2d
          parent_frame_id: world
          child_frame_id: snake_baselink

      optitrack_config:
        multicast_address: 239.255.42.99
        command_port: 1510
        data_port: 1511
    </rosparam>
  </node>
</launch>
